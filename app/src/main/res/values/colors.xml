<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      MINtv control-room palette, taken from the launcher icon: near-black ground,
      broadcast-magenta tally, cool rack-panel greys. Magenta is a signal, never
      wallpaper: it marks ON AIR, the selected destination and the primary action.
    -->
    <color name="brand">#E6007E</color>
    <color name="brand_bright">#FF3D9A</color>
    <color name="brand_deep">#8F004E</color>
    <color name="brand_ghost">#24E6007E</color>
    <color name="brand_ghost_soft">#12E6007E</color>
    <color name="on_brand">#FFFFFFFF</color>

    <color name="bg">#07080B</color>
    <color name="bg_raised">#0B0D11</color>
    <color name="surface">#12151B</color>
    <color name="surface_2">#191E26</color>
    <color name="surface_3">#222934</color>
    <color name="surface_focus">#2A323E</color>
    <color name="surface_focused">@color/surface_focus</color>
    <color name="success_soft">#1F5BD6A0</color>

    <color name="stroke">#242B35</color>
    <color name="stroke_strong">#39424F</color>
    <color name="stroke_soft">#1A2028</color>

    <color name="text_primary">#F4F6F9</color>
    <color name="text_secondary">#AEB6C2</color>
    <color name="text_tertiary">#7B8492</color>
    <color name="text_disabled">#525C69</color>

    <color name="success">#5BD6A0</color>
    <color name="warning">#FFB454</color>
    <color name="danger">#FF6B6B</color>

    <!-- Legacy aliases used by older screens. -->
    <color name="accent">@color/brand</color>
    <color name="accent_bright">@color/brand_bright</color>
    <color name="on_accent">@color/on_brand</color>

    <color name="focus_ring">#FFFFFFFF</color>
    <color name="scrim_top">#E607080B</color>
    <color name="scrim_bottom">#0007080B</color>
    <color name="scrim_flat">#CC000000</color>
    <color name="scrim_panel">#F20B0D11</color>
</resources>

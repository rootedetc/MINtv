<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:id="@+id/login_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!--
                Responsive panel: 76dp side margins on top of the 24dp page padding give
                the 760dp sheet at 960dp and shrink it on narrower displays, so the right
                edge (and its 1dp hairline) can never fall outside the screen.
            -->
            <LinearLayout
                android:id="@+id/login_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="76dp"
                android:layout_marginEnd="76dp"
                android:background="@drawable/bg_login_panel"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/brand" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 1dp inset so the panel's own hairline stays visible on the left
                         and under the rail instead of being painted over by its fill. -->
                    <LinearLayout
                        android:id="@+id/login_brand_column"
                        android:layout_width="96dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="1dp"
                        android:layout_marginBottom="1dp"
                        android:background="@color/bg"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingTop="24dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="20dp">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:contentDescription="@string/app_name"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_launcher" />

                        <View
                            android:layout_width="3dp"
                            android:layout_height="64dp"
                            android:layout_marginTop="18dp"
                            android:background="@color/brand" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/barlow_condensed_medium"
                            android:gravity="center"
                            android:letterSpacing="0.08"
                            android:maxLines="2"
                            android:text="@string/login_panel_label"
                            android:textAllCaps="true"
                            android:textColor="@color/text_tertiary"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <View
                        android:id="@+id/login_brand_divider"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/stroke" />

                    <LinearLayout
                        android:id="@+id/login_form"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="28dp"
                        android:paddingTop="24dp"
                        android:paddingEnd="28dp"
                        android:paddingBottom="22dp">

                        <TextView
                            android:id="@+id/login_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/barlow_condensed_semibold"
                            android:letterSpacing="0.01"
                            android:text="@string/login_title"
                            android:textColor="@color/text_primary"
                            android:textSize="32sp" />

                        <TextView
                            android:id="@+id/login_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/login_subtitle"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/login_username_label"
                            style="@style/Text.MinTv.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/label_username" />

                        <EditText
                            android:id="@+id/input_username"
                            style="@style/Text.MinTv.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:autofillHints="username"
                            android:importantForAutofill="no"
                            android:hint="@string/hint_username"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:nextFocusForward="@+id/input_password" />

                        <TextView
                            android:id="@+id/login_password_label"
                            style="@style/Text.MinTv.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/label_password" />

                        <EditText
                            android:id="@+id/input_password"
                            style="@style/Text.MinTv.Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:autofillHints="password"
                            android:importantForAutofill="no"
                            android:hint="@string/hint_password"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:nextFocusDown="@+id/checkbox_remember" />

                        <Switch
                            android:id="@+id/checkbox_remember"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/remember_password"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:thumbTint="@color/brand"
                            android:trackTint="@color/stroke_strong" />

                        <LinearLayout
                            android:id="@+id/login_actions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/button_login"
                                style="@style/Widget.MinTv.Button.Primary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="170dp"
                                android:minHeight="50dp"
                                android:text="@string/action_login" />

                            <ProgressBar
                                android:id="@+id/login_progress"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="16dp"
                                android:indeterminateTint="@color/brand"
                                android:visibility="gone" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/button_skip"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_button_ghost"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="@font/barlow_condensed_semibold"
                                android:gravity="center"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:text="@string/login_skip"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/login_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:maxLines="2"
                            android:textColor="@color/text_tertiary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/login_secure"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@color/bg_raised"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:padding="10dp"
                            android:text="@string/login_secure"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

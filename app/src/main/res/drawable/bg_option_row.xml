<?xml version="1.0" encoding="utf-8"?>
<!--
    Option row: the selected state is a flat raised fill (the magenta radio is the
    marker). Focus is the only outline, so selected + focused never reads as two rules.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focus" />
            <stroke android:width="2dp" android:color="@color/focus_ring" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="@color/stroke_soft" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>

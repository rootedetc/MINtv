<?xml version="1.0" encoding="utf-8"?>
<!--
  Whole-card focus rule. Drawn as the card root's foreground so the opaque logo
  plate cannot cover it: focused = transparent fill + 2dp white rule; every other
  state is fully transparent, leaving the card surface and pressed fill to bg_card.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/focus_stroke"
                android:color="@color/focus_ring" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom scrim over the channel grid: the peeking third row dissolves into the ground.
     Opaque at the bottom edge, clear at the top, so the grid fades out as it is clipped. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#FF07080B"
        android:endColor="#0007080B" />
</shape>
